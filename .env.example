# Full backend REST base URL, including the global prefix and API version.
NEXT_PUBLIC_QALAGEDU_API_URL=https://api.example.invalid/api/v1

# Must match `${AUTH_COOKIE_NAME}_csrf` in qalagedu-backend.
NEXT_PUBLIC_QALAGEDU_CSRF_COOKIE_NAME=example_session_csrf

NEXT_PUBLIC_APP_URL=https://dashboard.example.invalid
NEXT_PUBLIC_BRAND_NAME=Example Learning
NEXT_PUBLIC_DASHBOARD_NAME=Example Operations Dashboard
NEXT_PUBLIC_BRAND_SHORT_NAME=Example
NEXT_PUBLIC_BRAND_DESCRIPTION=Example internal operations dashboard description
NEXT_PUBLIC_CENTER_NAME=Example Learning Center
NEXT_PUBLIC_BRAND_LOGO_SRC=/brand/example-mark.svg
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.invalid
NEXT_PUBLIC_SUPPORT_PHONE=+000000000000
NEXT_PUBLIC_SUPPORT_WHATSAPP=000000000000
